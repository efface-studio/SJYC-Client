# 공개 환경 변수만 둔다. NEXT_PUBLIC_* 값은 브라우저 번들에 포함되므로 비밀 값을 넣지 않는다.
# OAuth client secret, AWS 키, DB 비밀번호 등은 서버(SJYC-Server)의 비밀 저장소에서만 관리한다.

# mock: 브라우저 내 개발용 데이터(기본값) / http: 실제 서버 API
NEXT_PUBLIC_API_MODE=mock

# http 모드에서 필수. 예) https://api.example.org/v1
NEXT_PUBLIC_API_BASE_URL=

# 서버에 실제로 설정이 끝난 소셜 로그인 공급자만 쉼표로 나열 (kakao,naver,apple,google)
# 비워 두면 모든 소셜 로그인 버튼이 "설정 필요" 상태로 표시된다.
NEXT_PUBLIC_OAUTH_PROVIDERS=
